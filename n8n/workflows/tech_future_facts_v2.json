    {
      "id": "f1c59398-bc49-4e55-afa4-58a3d19bcf26",
      "name": "Extract Video Link",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1632,
        -112
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const videos = $json.videos;\nconst query = $('Split Out').item.json.scenes.visual_query;\n\nfunction pickBest(list) {\n  if (!list || !list.length) return null;\n  const v = list[Math.floor(Math.random() * list.length)];\n  const files = (v.video_files || []).filter(f => f.width);\n  if (!files.length) return null;\n  return files.reduce((best, cur) => (cur.width > best.width ? cur : best)).link;\n}\n\nlet video_url = pickBest(videos);\n\nif (!video_url && $env.PIXABAY_API_KEY) {\n  const pixabay = await this.helpers.httpRequest({\n    method: 'GET',\n    url: 'https://pixabay.com/api/videos/',\n    qs: { key: $env.PIXABAY_API_KEY, q: query, video_type: 'film', orientation: 'vertical' },\n    json: true\n  });\n  const hit = (pixabay.hits || [])[0];\n  if (hit) video_url = (hit.videos.medium || hit.videos.small || hit.videos.large || {}).url || null;\n}\n\nreturn { json: { video_url } };"
      }
    },
