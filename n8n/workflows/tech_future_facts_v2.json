    {
      "id": "565d1996-6c00-4816-97fd-80432cbc24dd",
      "name": "Platform Captions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        2960,
        -212
      ],
      "parameters": {
        "jsCode": "const title = $('Code in JavaScript').first().json.title;\nconst scenes = $('Code in JavaScript').first().json.scenes;\nconst mainFact = scenes[0].text;\n\nconst instagramCaption = `${title} \\ud83e\\udd2f\\n\\n${mainFact}\\n\\n#TechFacts #DidYouKnow #FutureTech #ScienceFacts #TechNews #AI #Innovation`;\nconst facebookCaption = `${title}\\n\\n${mainFact}\\n\\nFollow for more tech & science facts!`;\nconst linkedinCaption = `${title}\\n\\n${mainFact}\\n\\n#Technology #Innovation #Science`;\n\nreturn [{\n  json: { title, instagramCaption, facebookCaption, linkedinCaption },\n  binary: $input.item.binary\n}];"
      }
    },
    {
      "id": "4e98325a-eb0e-4928-9a3d-39e4ccc71c2a",
      "name": "Build Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        3180,
        -212
      ],
      "parameters": {
        "jsCode": "const data = $json;\nconst emailHTML = `\n<!DOCTYPE html>\n<html><head><style>\nbody { font-family: Arial, sans-serif; max-width: 800px; margin: auto; padding: 20px; background: #f5f5f5; }\n.container { background: white; padding: 30px; border-radius: 10px; }\nh1 { color: #1a1a2e; border-bottom: 3px solid #e94560; padding-bottom: 10px; }\nh2 { color: #16213e; margin-top: 25px; }\n.section { background: #fafafa; padding: 15px; border-radius: 8px; margin: 10px 0; border-left: 4px solid #e94560; white-space: pre-wrap; }\n.footer { margin-top: 25px; text-align: center; color: #666; font-size: 13px; }\n</style></head><body><div class=\"container\">\n<h1>\\ud83c\\udfac New Video Ready: ${data.title}</h1>\n<p>Video is attached below. Download and post manually to your platforms.</p>\n<h2>\\ud83d\\udcf8 Instagram Caption</h2><div class=\"section\">${data.instagramCaption}</div>\n<h2>\\ud83d\\udc4d Facebook Caption</h2><div class=\"section\">${data.facebookCaption}</div>\n<h2>\\ud83d\\udcbc LinkedIn Caption</h2><div class=\"section\">${data.linkedinCaption}</div>\n<div class=\"footer\">Generated by n8n Tech & Future Facts Agent</div>\n</div></body></html>`;\n\nreturn [{\n  json: { subject: `\\ud83c\\udfac New Video: ${data.title}`, html: emailHTML, title: data.title },\n  binary: $input.item.binary\n}];"
      }
    },
